# Скопируйте этот файл в .env (в ту же папку, где лежит config.json) и заполните значения.
# Без ключей остальные функции работают; тексты песен будут браться только из lrclib.net.

# Spotify Developer Dashboard: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Ключ Spicy Lyrics (секрет из их клиента/расширения)
SPICY_LYRICS_SECRET_KEY=
